{
  "name": "tokyo-night",
  "meta": {
    "variant": "dark",
    "blurb": "A clean, dark theme that celebrates the lights of downtown Tokyo at night.",
    "author": "Zeta"
  },
  "palette": {
    "bg": "#1a1b26",
    "surface": "#24283b",
    "surface2": "#2f3549",
    "text": "#c0caf5",
    "muted": "#565f89",
    "accent": "#7aa2f7",
    "ok": "#9ece6a",
    "warn": "#e0af68",
    "err": "#f7768e",
    "info": "#7dcfff",
    "magenta": "#bb9af7",
    "cyan": "#7dcfff"
  },
  "glyphs": {},
  "prompt": {
    "left": [
      { "segment": "context", "style": "plain", "fg": "muted" },
      { "segment": "dir", "style": "pill", "bg": "accent", "fg": "bg", "bold": true },
      { "segment": "git", "style": "pill", "bg": "surface2", "fg": "magenta" },
      { "segment": "langs", "style": "plain", "fg": "info" },
      { "segment": "kube", "style": "plain", "fg": "cyan" },
      { "segment": "aws", "style": "plain", "fg": "warn" },
      { "segment": "venv", "style": "plain", "fg": "ok" },
      { "segment": "status", "style": "pill", "bg": "err", "fg": "bg" }
    ],
    "right": [
      { "segment": "duration", "style": "plain", "fg": "muted" },
      { "segment": "clock", "style": "plain", "fg": "muted" }
    ]
  },
  "terminal": {
    "name": "Zeta Tokyo Night",
    "opacity": 92
  }
}
