{
  "name": "gruvbox-dark",
  "meta": {
    "variant": "dark",
    "blurb": "Retro groove, warm and soft. Built for long sessions.",
    "author": "Zeta"
  },
  "palette": {
    "bg": "#282828",
    "surface": "#3c3836",
    "surface2": "#504945",
    "text": "#ebdbb2",
    "muted": "#928374",
    "accent": "#fabd2f",
    "ok": "#b8bb26",
    "warn": "#fe8019",
    "err": "#fb4934",
    "info": "#83a598",
    "magenta": "#d3869b",
    "cyan": "#8ec07c"
  },
  "glyphs": {},
  "prompt": {
    "left": [
      { "segment": "context", "style": "plain", "fg": "muted" },
      { "segment": "dir", "style": "pill", "bg": "accent", "fg": "bg", "bold": true },
      { "segment": "git", "style": "plain", "fg": "cyan" },
      { "segment": "langs", "style": "plain", "fg": "info" },
      { "segment": "venv", "style": "plain", "fg": "ok" },
      { "segment": "status", "style": "pill", "bg": "err", "fg": "text" }
    ],
    "right": [
      { "segment": "duration", "style": "plain", "fg": "muted" },
      { "segment": "battery", "style": "plain", "fg": "muted" },
      { "segment": "clock", "style": "plain", "fg": "muted" }
    ]
  },
  "terminal": {
    "name": "Zeta Gruvbox",
    "opacity": 92
  }
}
